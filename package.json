{
  "name": "pwa-suite",
  "private": true,
  "version": "1.0.0",
  "description": "个人 PWA 工具集 monorepo",
  "scripts": {
    "build": "bash scripts/build-site.sh",
    "build:habit": "npm run build --prefix habit-tracker-pwa",
    "build:image": "npm run build --prefix image-hub-pwa",
    "build:things": "npm run build --prefix my-things-pwa",
    "dev:habit": "npm run dev --prefix habit-tracker-pwa",
    "dev:image": "npm run dev --prefix image-hub-pwa",
    "dev:things": "npm run dev --prefix my-things-pwa"
  }
}
